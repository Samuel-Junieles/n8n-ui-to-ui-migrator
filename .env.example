# ==========================================================
# Configuración del Orquestador de Migración UI to UI
# ==========================================================

# Puerto y anfitrión de n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Bogota

# Configuración del Ejecutor Playwright
PUERTO_EJECUTOR=3100
MAX_SIMULTANEOS=4

# Configuración de Browserless
BROWSERLESS_PORT=3000
CONCURRENT_SESSIONS=4
